+// DL+ extraction is character-indexed, not byte-indexed (ETSI TS 102 980).
+static std::string dlplus_utf8_substr(const std::string& text, size_t start, size_t length) {
+    size_t cp = 0, begin = text.size(), end = text.size();
+    for (size_t i = 0; i < text.size(); ++i) {
+        if ((static_cast<unsigned char>(text[i]) & 0xc0) == 0x80) continue;
+        if (cp == start) begin = i;
+        if (cp == start + length) {end = i; break;}
+        ++cp;
+    }
+    return begin < text.size() ? text.substr(begin, end - begin) : std::string();
+}
